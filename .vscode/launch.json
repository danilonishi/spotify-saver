{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "uvicorn",
            "args": [
                "spotifysaver.api.main:app",
                "--reload"
            ],
            "jinja": true,
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "SpotifySaver CLI",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "spotifysaver",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}