# Host folders mounted into the container. Download locations selected in the
# UI are container paths (/music or /videos), not host paths.
MUSIC_DIR=./data/music
VIDEO_DIR=./data/videos
CONFIG_DIR=./data/config

# Standalone UI/API access is limited to this machine (127.0.0.1).
API_PORT=8000
LOG_LEVEL=info
IMAGE_TAG=latest
# Optional comma-separated trusted origins for a separate web frontend.
# The bundled interface uses the same origin; leave blank otherwise.
SPOTIFYSAVER_CORS_ORIGINS=

# Optional for command-line/headless Spotify features. In the web UI, configure
# Spotify credentials after signing in under Settings > Spotify Account.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional YouTube format fallback and cookies file are stored under
# CONFIG_DIR (the cookies path in the container is always /config/cookies.txt).
YTDLP_FORMAT=best[ext=m4a]/best

# For the Caddy proxy override, set this to the existing shared Docker network.
# CADDY_DOCKER_NETWORK=caddy
